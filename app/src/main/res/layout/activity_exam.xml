<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080C"
    android:padding="24dp">

    <ProgressBar
        android:id="@+id/examProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:progressTint="#00F0FF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvQuestionCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Soru: 1 / 10"
        android:textColor="#888899"
        app:layout_constraintTop_toBottomOf="@id/examProgressBar"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/questionCard"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvQuestionCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_neon_card">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivQuestionImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:alpha="0.4" />

            <TextView
                android:id="@+id/tvQuestionWord"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Adventure"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </FrameLayout>
            <TextView
                android:id="@+id/tvQuestionWord"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Word"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"/>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/hintContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/questionCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleImage"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Görseli Aç"
                android:textAllCaps="false"
                android:textColor="#00F0FF"
                app:strokeColor="#00F0FF"
                app:icon="@android:drawable/ic_menu_gallery"
                app:iconTint="#00F0FF"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleHint"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="İpucu Cümlesi"
                android:textAllCaps="false"
                android:textColor="#FFBB00"
                app:strokeColor="#FFBB00"
                app:icon="@android:drawable/ic_menu_info_details"
                app:iconTint="#FFBB00"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHintSentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Example sentence here."
            android:textColor="#BB86FC"
            android:textSize="16sp"
            android:visibility="gone"
            android:textStyle="italic" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/optionsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/questionCard"
        app:layout_constraintBottom_toTopOf="@id/btnNextQuestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        app:layout_constraintTop_toBottomOf="@+id/hintContainer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:text="Option 1"
            android:textAllCaps="false"
            android:textColor="#00F0FF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:strokeColor="#00F0FF"
            app:strokeWidth="2.5dp"
            app:cornerRadius="25dp"
            app:rippleColor="#2200F0FF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:text="Option 2"
            android:textAllCaps="false"
            android:textColor="#00F0FF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:strokeColor="#00F0FF"
            app:strokeWidth="2.5dp"
            app:cornerRadius="25dp"
            app:rippleColor="#2200F0FF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOption3"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginBottom="12dp"
            android:text="Option 3"
            android:textAllCaps="false"
            android:textColor="#00F0FF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:strokeColor="#00F0FF"
            app:strokeWidth="2.5dp"
            app:cornerRadius="25dp"
            app:rippleColor="#2200F0FF" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNextQuestion"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="Sonraki"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#FF007A"
        app:cornerRadius="25dp"
        app:icon="@drawable/ic_arrow_forward"
        app:iconGravity="textEnd"
        app:iconTint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinishExam"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sınavı Bitir"
        android:textAllCaps="false"
        android:textColor="#888899"
        android:textSize="14sp"
        app:rippleColor="#11FFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/btnNextQuestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnNextQuestion"/>

</androidx.constraintlayout.widget.ConstraintLayout>