<?xml version="1.0" encoding="utf-8"?>
<!-- Wordle giriş alanı için arka plan tasarımı -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- İç dolgu rengi (Koyu Gri) -->
    <solid android:color="#1E1E1E" />
    <!-- Kenarlık (Mor renk, 2dp kalınlık) -->
    <stroke
        android:width="2dp"
        android:color="#6750A4" />
    <!-- Köşe yuvarlama -->
    <corners android:radius="12dp" />
    <!-- İç boşluklar -->
    <padding
        android:bottom="8dp"
        android:left="12dp"
        android:right="12dp"
        android:top="8dp" />
</shape>