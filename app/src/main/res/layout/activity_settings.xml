<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080C"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/rounded_button_background"
        android:backgroundTint="#12121A"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Geri Dön"
        app:tint="#00F0FF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Ayarlar"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:text="Sınav Soru Sınırı"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etExamQuestionLimit"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:background="@drawable/rounded_button_background"
            android:backgroundTint="#12121A"
            android:gravity="center"
            android:hint="10"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#444455" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="soru"
            android:textColor="#888899"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#222233" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearData"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="start|center_vertical"
        android:text="Tüm Verileri Sıfırla"
        android:textAllCaps="false"
        android:textColor="#FF0055"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="start|center_vertical"
        android:text="Çıkış Yap"
        android:textAllCaps="false"
        android:textColor="#FF0055"
        android:textStyle="bold"
        app:icon="@android:drawable/ic_lock_power_off"
        app:iconTint="#FF0055" />

</LinearLayout>