<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080C"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_neon_back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#00F0FF"
            android:contentDescription="Geri Dön" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yeni Kelime Ekle"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etEngWord"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#00F0FF"
            android:hint="İngilizce Kelime"
            android:textColor="#FFFFFF"
            android:textColorHint="#666677" />

        <EditText
            android:id="@+id/etTurWord"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#00F0FF"
            android:hint="Türkçe Karşılığı"
            android:textColor="#FFFFFF"
            android:textColorHint="#666677" />

        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#00F0FF"
            android:hint="Kategori"
            android:textColor="#FFFFFF"
            android:textColorHint="#666677" />

        <EditText
            android:id="@+id/etSamples"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#00F0FF"
            android:gravity="top"
            android:hint="Örnek Cümleler"
            android:textColor="#FFFFFF"
            android:textColorHint="#666677" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectImage"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:text="Resim Seç"
            android:textColor="#08080C"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_neon_button"
            app:backgroundTint="@null"
            app:cornerRadius="25dp"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconTint="#08080C" />

        <ImageView
            android:id="@+id/ivSelectedImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="20dp"
            android:scaleType="centerInside"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveWord"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_neon_filled_stroke"
            android:text="Kelimeyi Kaydet"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="25dp" />

    </LinearLayout>
</ScrollView>