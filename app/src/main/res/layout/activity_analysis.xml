<?xml version="1.0" encoding="utf-8"?>
<!-- Başarı Analiz Raporu Ekranı Layout Dosyası -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080C"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Üst Bar: Geri ve Rapor Yazdırma Butonları -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/WordBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_neon_back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#00F0FF"
            android:contentDescription="Geri Dön" />

        <ImageButton
            android:id="@+id/btnPrintReport"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_neon_back"
            android:src="@android:drawable/ic_menu_save"
            app:tint="#00F0FF"
            android:contentDescription="Raporu Yazdır" />
    </RelativeLayout>

    <!-- Başlık -->
    <TextView
        android:id="@+id/tvAnalysisTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Başarı Analiz Raporu"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Özet İstatistik Kartı -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#1A1A24"> 
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="20dp"
            android:rowCount="2">

            <TextView
                android:id="@+id/tvTotalWordsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toplam Kelime\n0"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAccuracyRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Başarı Oranı\n%0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </GridLayout>
    </androidx.cardview.widget.CardView>

    <!-- Kategori Bazlı Detaylar -->
    <TextView
        android:id="@+id/tvCategoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:text="Kategori Bazlı İlerleme"
        android:textColor="#888899"
        android:textSize="16sp" />

    <!-- İlerleme Listesi -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTopicProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>