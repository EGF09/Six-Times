<?xml version="1.0" encoding="utf-8"?>
<!-- Çok katmanlı neon pembe buton tasarımı -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dış katman (Ana Neon Pembe) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF007A" />
            <corners android:radius="10dp" />
            <stroke
                android:width="3dp"
                android:color="#FF007A" />
        </shape>
    </item>
    <!-- İç katman (Daha açık pembe, parlama efekti için) -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="#FF5DA1" /> </shape>
    </item>
</layer-list>