<?xml version="1.0" encoding="utf-8"?>
<!-- Kategori İlerleme Listesi İçin Öğe (Item) Tasarımı -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A24"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Bilgi Başlığı: Konu Adı ve Yüzdelik -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTopicName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Konu Adı"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0 (%0)"
                android:textColor="#FF007A"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Görsel İlerleme Çubuğu -->
        <ProgressBar
            android:id="@+id/progressBarTopic"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#08080C"
            android:progressTint="#00F0FF"
            android:progressDrawable="@drawable/custom_progress_bar" />

    </LinearLayout>
</androidx.cardview.widget.CardView>