<?xml version="1.0" encoding="utf-8"?>
<!-- Giriş Yap (Login) Ekranı Layout Dosyası -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08080C"
    tools:context=".MainActivity">

    <!-- Giriş Formu: Email Alanı -->
    <ImageView
        android:id="@+id/imageViewAccount"
        android:layout_width="21dp"
        android:layout_height="17dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/textView3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView3"
        app:srcCompat="@android:drawable/ic_dialog_email"
        app:tint="#00F0FF" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="98dp"
        android:gravity="right|center_vertical"
        android:text="Email:  "
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toEndOf="@+id/imageViewAccount"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/emailLogin"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="98dp"
        android:layout_marginEnd="16dp"
        android:ems="10"
        android:inputType="text"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00F0FF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textView3"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Giriş Formu: Şifre Alanı -->
    <ImageView
        android:id="@+id/imageViewLock"
        android:layout_width="21dp"
        android:layout_height="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/textView4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView4"
        app:srcCompat="@drawable/lock"
        app:tint="#00F0FF" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="44dp"
        android:gravity="right|center_vertical"
        android:text="Şifre:  "
        android:textAlignment="textEnd"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toEndOf="@+id/imageViewLock"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <EditText
        android:id="@+id/passLogin"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="16dp"
        android:ems="10"
        android:inputType="textPassword"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00F0FF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textView4"
        app:layout_constraintTop_toBottomOf="@+id/emailLogin" />

    <!-- Aksiyon Butonları: Giriş, Kayıt ve Şifre Hatırlatma -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/GirisYapButton"
        android:layout_width="259dp"
        android:layout_height="54dp"
        android:layout_marginTop="46dp"
        android:text="Giriş Yap"
        android:textColor="#08080C"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/bg_neon_button"
        app:backgroundTint="@null"
        app:cornerRadius="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/KayitOlButton"
        android:layout_width="163dp"
        android:layout_height="50dp"
        android:layout_marginTop="21dp"
        android:text="Kayıt Ol"
        android:textColor="#08080C"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/bg_neon_button"
        app:backgroundTint="@null"
        app:cornerRadius="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/GirisYapButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/SifremiUnuttumButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:text="Şifremi Unuttum"
        android:textColor="#FF007A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:backgroundTint="#00FFFFFF"
        app:rippleColor="#22FF007A"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/KayitOlButton" />

</androidx.constraintlayout.widget.ConstraintLayout>